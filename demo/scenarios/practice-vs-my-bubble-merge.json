{
  "name": "Practice Bubble versus My Bubble merge",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "videoSize": {
    "width": 390,
    "height": 844
  },
  "locale": "en-NZ",
  "timezoneId": "Pacific/Auckland",
  "colorScheme": "light",
  "headless": true,
  "steps": [
    {
      "action": "goto",
      "url": "{{baseUrl}}/demo/bubble-merge.html",
      "waitUntil": "networkidle",
      "holdAfter": 1800
    },
    {
      "action": "waitForAny",
      "candidates": [
        { "testId": "bubble-comparison" },
        { "text": "Your latest pattern is ready" }
      ],
      "holdAfter": 1800
    },
    {
      "action": "screenshot",
      "path": "01-practice-vs-my-bubble.png"
    },
    {
      "action": "pause",
      "duration": 2200
    },
    {
      "action": "clickFirst",
      "candidates": [
        { "testId": "merge-practice-bubble" },
        { "role": "button", "name": "Merge into My Bubble" }
      ],
      "holdAfter": 1600
    },
    {
      "action": "waitForAny",
      "candidates": [
        { "testId": "bubble-merge-complete" },
        { "text": "My Bubble updated" }
      ],
      "holdAfter": 2200
    },
    {
      "action": "screenshot",
      "path": "02-merged-my-bubble.png"
    },
    {
      "action": "pause",
      "duration": 1800
    }
  ]
}