{
  "name": "clarity-caddie-core",
  "version": "1.0.1",
  "private": true,
  "description": "Clarity Caddy app baseline with locked Green Wand green-centred tile crop.",
  "scripts": {
    "start": "python3 -m http.server 5173",
    "serve": "python3 -m http.server 5173",
    "build:netlify": "node scripts/clarity-deploy-build.js",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "postversion": "node scripts/clarity-release.js",
    "test:payments": "node dev/payment-rollout-tests.js",
    "test:scorecard-resolve": "node dev/scorecard-resolve.test.js",
    "test:scorecard-parse": "node dev/scorecard-parse-core.test.js",
    "test:course-rename": "node dev/course-rename-core.test.js",
    "test:multi-course": "node dev/multi-course-separation.test.js",
    "test:listing-led": "node dev/listing-led-resolution.test.js",
    "test:unnumbered-facility": "node dev/unnumbered-multi-loop.test.js",
    "test:facility-loops": "node dev/facility-loops.test.js",
    "test:facility-structure": "node dev/facility-structure.test.js",
    "test:stitched-cards": "node dev/scorecard-stitched-cards.test.js",
    "test:loop-labels": "node dev/loop-labels.test.js",
    "test:bag": "node dev/bag-central-system.test.js",
    "test:bag-generator": "node dev/bag-generator-model.test.js",
    "test:bubble-handedness": "node dev/bubble-handedness.test.js",
    "test:bubble-frame": "node dev/bubble-frame-core.test.js",
    "test:boot": "node dev/boot-smoke.test.js",
    "test:practice-parser": "node dev/practice-parser-parity.test.js",
    "test:practice-csv": "node dev/practice-csv-regression.test.js",
    "test:practice-adapter": "node dev/practice-library-adapter.test.js",
    "test:practice-graph": "node dev/practice-graph-regression.test.js",
    "test:practice-scanner": "node dev/practice-scanner-surface.test.js",
    "test:bubble-geometry": "node dev/bubble-micro-geometry.test.js",
    "test:manual-practice": "node dev/manual-practice-core.test.js && node dev/manual-practice-integration.test.js",
    "test:practice-email": "node dev/practice-email-intake.test.js",
    "test:practice-email-admin": "node dev/practice-email-admin.test.js",
    "test:scorecard-ocr": "node dev/scorecard-ocr-strips.test.js && node dev/scorecard-ocr-split.test.js && node dev/scorecard-ocr-image.test.js",
    "test:table-ocr": "node dev/table-ocr-boxes.test.js && node dev/table-ocr-split.test.js && node dev/table-ocr-semantics.test.js && node dev/table-ocr-words.test.js && node dev/table-ocr-strips.test.js && node dev/table-ocr-deepscan.test.js",
    "test:practice": "npm run test:practice-parser && npm run test:practice-csv && npm run test:practice-adapter && npm run test:practice-graph && npm run test:practice-scanner && npm run test:practice-email && npm run test:table-ocr && npm run test:practice-email-admin && npm run test:bubble-geometry && npm run test:manual-practice",
    "test:studio-preview-truth": "node dev/studio-preview-truth.test.js",
    "test:green-contours": "node dev/green-contours-wiring.test.js",
    "test:shadow-lift": "node dev/shadow-lift.test.js",
    "test:courses-near": "node dev/courses-near.test.js",
    "test:course-pin-trust": "node dev/course-pin-trust.test.js",
    "test:guest-identity": "node dev/course-guest-identity.test.js",
    "test:course-scan-lifecycle": "node dev/course-guest-identity.test.js && node dev/course-package-trigger.test.js && node dev/course-mapper-jobs.test.js && node dev/course-mapping-controller.test.js && node dev/course-picker-behavior.test.js && node dev/course-pin-trust.test.js",
    "test:watch-maps": "node dev/watch-map-core.test.js && node dev/course-watch-maps.test.js && node dev/watch-map-delivery.test.js",
    "test:watch-player": "node dev/watch-player-delivery.test.js",
    "test:bubble-parity": "node dev/bubble-engine-parity.test.js",
    "test:bubble-parity:swift": "swift test --package-path ios/WatchBubbleEngine",
    "test:bubble-parity:update": "node dev/bubble-engine-parity.test.js --update",
  "test:nearest-loop": "node dev/nearest-loop-tightening.test.js",
    "test:unlicensed-region": "node dev/unlicensed-region-live-map.test.js",
    "build:app": "node scripts/clarity-deploy-build.js --app-only",
    "demo:list": "node demo/run-demo.mjs --list",
    "demo:capture": "node demo/run-demo.mjs",
    "demo:capture:local": "DEMO_BASE_URL=http://127.0.0.1:5173 node demo/run-demo.mjs",
    "demo:capture:bubble-merge": "DEMO_BASE_URL=http://127.0.0.1:5173 node demo/run-demo.mjs --scenario practice-vs-my-bubble-merge",
    "demo:install": "npx playwright-core install chromium",
  "native:sync": "npm run build:app && npx cap sync && node scripts/register-native-round-bridge.js",
    "native:android": "npm run native:sync && npx cap open android",
    "native:ios": "npm run native:sync && npx cap open ios",
    "native:release:aab": "npm run build:app && npx cap sync android && cd android && ./gradlew bundleRelease",
    "native:release:apk": "npm run build:app && npx cap sync android && cd android && ./gradlew assembleRelease",
    "test:coach-player": "node dev/coach-player-link.test.js",
    "test:account-email": "node dev/account-email-change.test.js",
    "test:effective-player-play": "node dev/effective-player-play-context.test.js"
  },
  "codex": {
    "entry": "index.html",
    "lockedBaseline": "clarity-caddie-core",
    "doNotModify": [
      "Green Wand sandbox engine",
      "green-centred Leaflet tile crop sample source",
      "crop seed at centre",
      "crop-output back to lat/lng conversion",
      "Wand probe/ridge/magnetic shell logic"
    ]
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@netlify/blobs": "^10.7.9",
    "@revenuecat/purchases-capacitor": "^13.2.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "playwright-core": "^1.56.0"
  }
}
