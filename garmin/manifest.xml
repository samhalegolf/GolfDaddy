<?xml version="1.0" encoding="UTF-8"?>
<!--
  Clarity Caddy — Garmin Connect IQ app manifest.

  APP UUID: developer-generated, NOT issued by the Connect IQ portal. Garmin
  issues a separate *Store* UUID when the app is first published; that one
  lives in the portal, not here. This id must stay STABLE across every future
  version — changing it makes the store treat the upload as a brand new app
  and orphans existing installs and reviews.
  (VS Code equivalent: "Monkey C: Regenerate UUID" — do not run it on this
  project once published.)

  Product ids are cross-checked against Garmin's Compatible Devices list.
  Approach S70 ships in two sizes and has a separate id per size.
  Before building, confirm each id is present in your installed SDK's device
  list (`~/Library/Application Support/Garmin/ConnectIQ/Devices/`) and that
  you have downloaded that device in the SDK Manager — the compiler fails on
  a product id it has no device definition for.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="fac5991c01f348ddb7577553071ddd0f"
        type="watch-app"
        name="@Strings.AppName"
        entry="ClarityCaddyApp"
        launcherIcon="@Drawables.LauncherIcon"
        minSdkVersion="3.0.0">
        <!-- Connect IQ 3.0 baseline per plan step 29. The 3.2.0 minimum this
             carried until 2026-09-19 was a guess, and it locked out the
             Approach S62 entirely: that device tops out at CIQ 3.0.12, so
             the compiler refused it outright. Verified against SDK 9.2.0
             before relaxing — the companion-app messaging APIs this project
             depends on are both far older than 3.0:
               Communications.registerForPhoneAppMessages  since API 1.0.0
               Communications.makeImageRequest             since API 1.2.0
             (the latter under its real name; makeImageRequestWithDictionary,
             named in the original note here, does not exist in the SDK).
             With this minimum all five products in the matrix below compile,
             the S62 included. Raise it again only for an API that genuinely
             needs it, and re-check the S62 when you do. -->
        <iq:products>
            <iq:product id="approachs62"/>
            <iq:product id="approachs7042mm"/>
            <iq:product id="approachs7047mm"/>
            <iq:product id="fenix6"/>
            <iq:product id="fr55"/>
            <!-- vivoactive4s is deliberately NOT here. It is the first real
                 Garmin this app ran on (2026-09-21, sideloaded) and the only
                 place the watch -> phone direction can be tested while the
                 simulator segfaults on transmit (see UPLOAD.md), but it is
                 not a golf watch and nothing here was designed for it.
                 Shipping it would put a golf app in front of owners of a
                 device it was never laid out for. To sideload to one
                 again, add a product line for it above for the duration of
                 that build and take it out before packaging — its
                 resourcePath line and 30x30 icon are still in monkey.jungle
                 and resources-icons/30, so that is the only edit needed.
                 Do NOT write the product tag out in full inside a comment:
                 build.sh's device check (and dev/garmin-launcher-icons.test.js)
                 read this file by grep, not by XML parse, and would count a
                 commented-out product as a shipped one. -->
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
