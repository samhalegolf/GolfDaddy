# Simulator-only overlay: a standalone demo round, no phone at all.
#
# Chained AFTER monkey.jungle by `CIQ_SIM_DEMO=1 ./build.sh build`. Against the
# default exclusion list:
#
#   sim_demo_off  is excluded, so GarminSimDemoPolicy's real definitions and
#                 GarminSimDemo (the phone's stand-in) compile in.
#   tx_live       is excluded, so nothing could reach a tether even if the
#                 stand-in let a message past - the simulator segfaults on
#                 transmit while tethered.
#   parity        stays excluded (every overlay names one of each pair; see
#                 dev/garmin-build-flavours.test.js).
#
# resources-sim-demo/ (generated by tools/make-sim-demo-fixture.js) adds the
# fixture course and its hole images. Each product line is repeated because a
# product's resourcePath is its own assignment. Never used by
# `./build.sh package`.
base.excludeAnnotations = tx_live;parity;sim_demo_off

base.resourcePath = resources;resources-sim-demo
