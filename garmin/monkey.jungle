project.manifest = manifest.xml

# Standard single-barrel layout: every .mc file under source/ compiles into
# one program and shares a global namespace (no per-file imports needed
# beyond `using Toybox.X` for SDK modules) — see garmin/README.md for the
# directory map.
base.sourcePath = source

# Live transport by default: the `tx_muted` definition of
# GarminTransmitPolicy.muted() is compiled out, so every normal build - and
# the store package - talks to the phone. monkey-sim-mute.jungle, chained on
# by `CIQ_MUTE_TX=1 ./build.sh build`, flips this for the simulator. See
# source/Session/GarminTransmitPolicy.mc.
# `parity` excludes the Bubble Engine parity harness and its generated
# fixture table (garmin/source/Test/) from every ordinary build — see
# source/Test/GarminParityPolicy.mc and monkey-parity.jungle.
# `sim_demo` excludes the standalone simulator demo (source/SimDemo/,
# monkey-sim-demo.jungle) the same way.
base.excludeAnnotations = tx_muted;parity;sim_demo

# `resources` holds everything that is the same on every device (strings).
# The launcher icon is NOT: Connect IQ asks a different pixel size per device
# and does not scale for you, so a single bitmap is stretched or shrunk by the
# device and looks it. Each size therefore lives in its own folder, and each
# product picks the one it actually wants.
#
# Sizes come from each device's own compiler.json (`launcherIcon`), not from
# guesswork, and the product lines below are GENERATED from those profiles by
# garmin/tools/sync-devices.js, along with the matching manifest.xml product
# list and any missing icon size (scaled from the 70 px one).
#
# Deliberately no icon in `base`. A product with no line below fails the build
# on a missing LauncherIcon, which is a loud, immediate error - far better
# than silently inheriting a wrong-size bitmap. Do not add products by hand:
# change the rules in sync-devices.js and re-run it.
base.resourcePath = resources

# GENERATED by garmin/tools/sync-devices.js: one line per shipped watch, its launcher icon
# folder chosen by the width that device's own compiler.json asks for.
