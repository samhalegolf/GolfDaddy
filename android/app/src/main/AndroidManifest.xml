<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Android App Links. Password reset and account setup emails link to
                https://caddy.claritygolf.app/?claritySetPassword=1, which opened
                the browser rather than the app, so a user following a reset link
                from their phone ended up resetting in a different session.

                autoVerify makes Android check
                https://caddy.claritygolf.app/.well-known/assetlinks.json against
                the installed app's signing certificate. If that file is missing
                or the fingerprint does not match, verification fails silently and
                links simply keep opening the browser - there is no error.

                launchMode is already singleTask, so a link delivers to the running
                instance via onNewIntent rather than starting a second one.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                Only the root shell, not the whole host. Android has no way to
                exclude a path, and the public course pages (/courses/<id>,
                functions/course-page.mjs) must open in the browser even with the
                app installed - a shared link that lands in the app is a dead link.
                Every deep link the app reads is on "/" (gd-native-deep-links.js
                only looks at the root shell's query), so nothing in use is lost;
                a NEW link type on another path has to be added here.
                -->
                <data android:scheme="https" android:host="caddy.claritygolf.app" android:path="/" />
                <data android:scheme="https" android:host="caddy.claritygolf.app" android:path="/index.html" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS play: the runtime owner holds a single watchPosition for the round.
         Coarse is declared alongside fine because Android 12+ lets the user
         grant approximate-only, and the picker's nearby-course lookup still
         works at that accuracy. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Practice Data: the guided camera opens the back camera inside the
         webview (getUserMedia) to frame a launch monitor shot table. Without
         this declaration the webview's permission request is refused outright
         and the button falls back to the phone camera app. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
