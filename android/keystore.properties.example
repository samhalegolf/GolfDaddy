# Copy to android/keystore.properties and fill in. That file is gitignored.
#
# NEVER commit the real file or the .jks keystore itself. Losing the upload
# keystore means losing the ability to update the app on Play unless Play App
# Signing key upgrade is used, so keep a backup somewhere durable and separate
# from this machine.
#
# Generate the keystore yourself (this asks for the passwords interactively -
# they should not be typed into a shell history or pasted anywhere shared):
#
#   keytool -genkeypair -v \
#     -keystore android/clarity-caddy-upload.jks \
#     -alias clarity-caddy-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to android/app, so a keystore at
# android/clarity-caddy-upload.jks is ../clarity-caddy-upload.jks here.

storeFile=../clarity-caddy-upload.jks
storePassword=
keyAlias=clarity-caddy-upload
keyPassword=

# CI alternative: leave this file absent and set these environment variables
# instead - ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS,
# ANDROID_KEY_PASSWORD.
