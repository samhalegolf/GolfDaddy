# Build output — regenerated by `npm run build:netlify`
/dist/

# Dependencies
node_modules/

# Demo capture output
/demo-output/

# Archives / large binaries (keep source, not zipped bundles)
*.zip

# OS / editor / filesystem junk
.DS_Store
**/.DS_Store
.fuse_hidden*
__MACOSX/
Thumbs.db

# Per-machine Claude Code settings (tool permissions, local overrides). Only the
# .local variant - .claude/settings.json is shared project config and SHOULD be
# committed if this project ever adds one.
.claude/settings.local.json

# Local env
.env
.env.*
!.env.example

# Temporary on-device diagnostics - never commit
scripts/inline/gd-native-diag-temp.js

# Android release signing - credentials must never enter the repository.
# Losing the upload keystore means losing the ability to update the app on Play.
android/keystore.properties
*.jks
*.keystore

# Local Netlify folder
.netlify

# Regenerated by `netlify dev` every run (its edge-function bootstrap), and
# this project ships no edge functions - local artifact, not source.
deno.lock

# Scratch quarantine folder used when a tool can't delete a file directly
# (e.g. the remote device bridge) - it mv's the file here instead. Local
# only, never meant to be committed. 18 stray .git/index.lock-style files
# ended up tracked from here in the past; this stops that happening again.
_to_delete/
iap-review-screenshot-2048x2732.png
